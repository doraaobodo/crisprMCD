export_plot_gene_tables <- function(gout, out_file) {
wb <- createWorkbook()
export_cols <- intersect(
c(
"group_id",
"embedding_cluster",
"gene_class",
"gene",
"pattern",
"local_dominant_sign_meaning",
"mahalanobis",
"ssZ",
"p_global",
"eff_n",
"top_gene_flag"
),
names(gout)
)
for (g in unique(gout$group_id)) {
sheet <- substr(gsub("[^A-Za-z0-9_]", "_", g), 1, 31)
addWorksheet(wb, sheet)
dt <- unique(gout[group_id == g, ..export_cols])
setorder(dt, embedding_cluster, gene_class, -mahalanobis)
writeDataTable(wb, sheet, dt)
freezePane(wb, sheet, firstRow = TRUE)
setColWidths(wb, sheet, cols = 1:ncol(dt), widths = "auto")
}
saveWorkbook(wb, out_file, overwrite = TRUE)
}
